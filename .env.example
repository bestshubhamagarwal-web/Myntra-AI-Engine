# Postgres
DATABASE_URL=postgresql://discovery:discovery@localhost:5432/discovery

# Groq (generation only). Do not add OpenAI chat or embedding keys.
# Model ids are frozen in src/config.py (FROZEN_GROQ_MODEL*). Changing them
# without a git commit + eval re-run is a Phase 7 fail (EC-OP-03).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_LIGHT=openai/gpt-oss-20b

# Local BGE embeddings. Dimension must stay 1024 for BGE-M3 (pgvector column is vector(1024)).
# First load downloads weights into HF_HOME (~2GB). If Hugging Face is blocked, vendor
# BAAI/bge-m3 under ./data/models and set BGE_MODEL_ID to that local folder.
BGE_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIM=1024
HF_HOME=./data/models

# HMAC for author_hash (required). Never store plaintext usernames on analysis tables.
AUTHOR_HMAC_SECRET=change-me-to-a-long-random-string

# Object store for redacted raw snapshots
RAW_STORE_PATH=./data/raw

# Operator review dump (scrubbed JSONL / CSV / Markdown). Not committed.
REVIEW_DUMP_PATH=./data/review

# Play Store connector (Phase 1)
PLAY_STORE_APP_ID=com.myntra.android
PLAY_STORE_COUNTRY=in
PLAY_STORE_LANG=en
PLAY_STORE_MAX_REVIEWS=25000
PLAY_STORE_PAGE_SLEEP_SECONDS=0.2
# Set false to skip pulls and mark the source unavailable (do not invent metrics).
PLAY_STORE_ENABLED=true

# App Store connector (Phase 3) — official iTunes RSS, Myntra app only.
APP_STORE_APP_ID=907394059
APP_STORE_COUNTRY=in
APP_STORE_COUNTRIES=in,us,gb,ae,sg,au
APP_STORE_MAX_REVIEWS=20000
APP_STORE_PAGE_SLEEP_SECONDS=0.2
APP_STORE_ENABLED=true

# Reddit (PRAW client id/secret for read-only; public JSON is used if empty)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=myntra-discovery-engine/0.1 (research; public read-only)
REDDIT_SUBREDDITS=IndianFashionAddicts,IndianStreetwear,FashionReps,femalefashionadvice,malefashionadvice,india,AskIndia,Mumbai,delhi,bangalore,Pune,Hyderabad,Chennai,Kolkata,IndiaSpeaks
REDDIT_MAX_POSTS=400
REDDIT_MAX_COMMENTS_PER_POST=50
REDDIT_PAGE_SLEEP_SECONDS=1.2
REDDIT_ENABLED=true

# YouTube comments. Official Data API if YOUTUBE_API_KEY is set; otherwise public
# Invidious / Piped / Innertube (same idea as Reddit public JSON). Leave disabled
# to mark the source unavailable — do not impute metrics.
YOUTUBE_API_KEY=
YOUTUBE_MAX_VIDEOS=12
YOUTUBE_MAX_COMMENTS_PER_VIDEO=40
YOUTUBE_PAGE_SLEEP_SECONDS=0.4
YOUTUBE_ENABLED=true

# Fifth source: X. Public Nitter/RSSHub RSS if the bearer is empty; official API
# when X_BEARER_TOKEN is set. Set false to mark unavailable (do not impute).
X_BEARER_TOKEN=
X_MAX_TWEETS=50
X_PAGE_SLEEP_SECONDS=0.5
X_ENABLED=true

# Quantification constants (FROZEN — Architecture §8.5). Do not change silently.
# If you retune, update FROZEN_C_MAX / FROZEN_S_MAX in src/config.py, commit, and
# re-run `python -m src.cli eval`. See docs/Runbook.md.
C_MAX=200
S_MAX=4
# ALLOW_UNFROZEN_CONSTANTS=false

# Phase 4 clustering (HDBSCAN on L2-normalized BGE vectors; k-means only if HDBSCAN errors)

# Phase 4 clustering (HDBSCAN on L2-normalized BGE vectors; k-means only if HDBSCAN errors)
CLUSTER_MIN_CLUSTER_SIZE=5
CLUSTER_MIN_SAMPLES=5
CLUSTER_SELECTION_EPSILON=0.0
CLUSTER_METRIC=euclidean
CLUSTER_ALLOW_SINGLE_CLUSTER=true
CLUSTER_KNN_K=5
CLUSTER_KNN_MIN_SIMILARITY=0.55
CLUSTER_CENTROID_MATCH_MIN_SIMILARITY=0.70
CLUSTER_RECLUSTER_NEW_DOCS=40
CLUSTER_KMEANS_MAX_K=8
CLUSTER_KMEANS_NOISE_SIMILARITY=0.40
GROQ_LABEL_MAX_TOKENS=1024

# Phase 2 — Groq extract + local BGE embed
GROQ_EXTRACT_MAX_TOKENS=2048
GROQ_MAX_RETRIES=4
GROQ_JSON_RETRIES=3
GROQ_BACKOFF_BASE_SECONDS=2
GROQ_MAX_TPM=8000
# Sleep between Groq extract calls (raise if you hit 429). Tests keep 0.
GROQ_MIN_INTERVAL_SECONDS=0.5
EMBED_BATCH_SIZE=4
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# Phase 5 Query API + Copilot (localhost by default; set a secret if binding beyond loopback)
API_HOST=127.0.0.1
API_PORT=8000
API_SHARED_SECRET=
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REPORTS_PATH=./data/reports
SMALL_N_THRESHOLD=5

# Phase 7 overlapping cron/n8n lock (EC-IN-16 / EC-OP-06)
LOCK_PATH=./data/locks
LOCK_STALE_SECONDS=7200
# Used when Postgres is down so CLI ingest and the Query API share the same corpus.
LOCAL_STORE_PATH=./data/local_store.pkl
# Railway: fail if Postgres is down instead of serving an empty pickle store.
# The API Dockerfile sets REQUIRE_POSTGRES=true.
REQUIRE_POSTGRES=false
# POSTGRES_WAIT_SECONDS=60
# Railway injects PORT; `python -m src.cli serve` uses it when --port is omitted.

# Phase 6 Next.js (set these in web/.env.local as well)
# API_BASE_URL=http://127.0.0.1:8000
# API_SHARED_SECRET=
# Vercel: same two vars, server-only. Do not prefix NEXT_PUBLIC_.
# API_BASE_URL=https://<api>.up.railway.app

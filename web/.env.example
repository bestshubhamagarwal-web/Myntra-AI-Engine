# Phase 6 Next.js app — talks only to the Phase 5 Query API.
# Copy to web/.env.local (or set in the repo root .env and export before `npm run dev`).
#
# Local:
#   API_BASE_URL=http://127.0.0.1:8000
# Vercel (server-only — never NEXT_PUBLIC_):
#   API_BASE_URL=https://<api>.onrender.com
#   API_SHARED_SECRET=<same value as Render>

API_BASE_URL=http://127.0.0.1:8000
API_SHARED_SECRET=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "pip install -r requirements.txt && pip install --no-deps -e .",
  "buildCommand": "python vercel_build.py",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{web/**,tests/**,docs/**,data/**,evals/**,ops/**,.venv/**,**/node_modules/**,**/.next/**,**/test_*.py}"
    }
  }
}
